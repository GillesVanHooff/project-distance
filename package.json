{
  "name": "project-distance",
  "version": "0.1.0",
  "private": true,
  "description": "Idle/incremental browser game: travel from 1 Planck length to the edge of the observable universe.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GillesVanHooff/project-distance.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sim": "tsx sim/run.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "break_infinity.js": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
